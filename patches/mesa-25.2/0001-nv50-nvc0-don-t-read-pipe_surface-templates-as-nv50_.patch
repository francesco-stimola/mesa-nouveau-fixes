From b1226432ba40b7ef074bb38dac8667792c849c9c Mon Sep 17 00:00:00 2001
From: Francesco Stimola <francesco-stimola@users.noreply.github.com>
Date: Sat, 17 Oct 2026 21:34:23 +0200
Subject: [PATCH 01/13] nv50,nvc0: don't read pipe_surface templates as
 nv50_surface in clears

get_surfaces() in the VA frontend returns plain pipe_surface templates,
and since 718e277ab56e util_clear_texture_as_surface() passes one from
the stack for glClearTexImage. The nv50 and nvc0 clear hooks cast them to
nv50_surface and read past their end: every VA video start raises
TRAP_PROP SURF_HEIGHT_OVERRUN on nv50, and on nvc0 the WebGL texture
clears of Chromium-based browsers fault the channel.

Create the driver surface from the template in the hooks. nv84_video.c
passes a real nv50_surface, so it calls the internal helper directly.

Fixes: 718e277ab56e ("util/surface: delete more pipe_context::create_surface usage")
---
 .../drivers/nouveau/nv50/nv50_context.h       |  6 ++
 .../drivers/nouveau/nv50/nv50_surface.c       | 71 +++++++++++++----
 src/gallium/drivers/nouveau/nv50/nv84_video.c |  6 +-
 .../drivers/nouveau/nvc0/nvc0_surface.c       | 77 +++++++++++++++----
 4 files changed, 128 insertions(+), 32 deletions(-)

diff --git a/src/gallium/drivers/nouveau/nv50/nv50_context.h b/src/gallium/drivers/nouveau/nv50/nv50_context.h
index 2280622..4faaad8 100644
--- a/src/gallium/drivers/nouveau/nv50/nv50_context.h
+++ b/src/gallium/drivers/nouveau/nv50/nv50_context.h
@@ -315,6 +315,12 @@ extern void nv50_clear(struct pipe_context *, unsigned buffers,
                        const struct pipe_scissor_state *scissor_state,
                        const union pipe_color_union *color,
                        double depth, unsigned stencil);
+extern void nv50_clear_render_target_internal(struct pipe_context *,
+                                              struct nv50_surface *,
+                                              const union pipe_color_union *color,
+                                              unsigned dstx, unsigned dsty,
+                                              unsigned width, unsigned height,
+                                              bool render_condition_enabled);
 extern void nv50_init_surface_functions(struct nv50_context *);
 
 /* nv50_tex.c */
diff --git a/src/gallium/drivers/nouveau/nv50/nv50_surface.c b/src/gallium/drivers/nouveau/nv50/nv50_surface.c
index dbb0d04..caaf057 100644
--- a/src/gallium/drivers/nouveau/nv50/nv50_surface.c
+++ b/src/gallium/drivers/nouveau/nv50/nv50_surface.c
@@ -276,18 +276,18 @@ nv50_resource_copy_region(struct pipe_context *pipe,
    nouveau_bufctx_reset(nv50->bufctx, NV50_BIND_2D);
 }
 
-static void
-nv50_clear_render_target(struct pipe_context *pipe,
-                         struct pipe_surface *dst,
-                         const union pipe_color_union *color,
-                         unsigned dstx, unsigned dsty,
-                         unsigned width, unsigned height,
-                         bool render_condition_enabled)
+void
+nv50_clear_render_target_internal(struct pipe_context *pipe,
+                                  struct nv50_surface *sf,
+                                  const union pipe_color_union *color,
+                                  unsigned dstx, unsigned dsty,
+                                  unsigned width, unsigned height,
+                                  bool render_condition_enabled)
 {
    struct nv50_context *nv50 = nv50_context(pipe);
    struct nouveau_pushbuf *push = nv50->base.pushbuf;
+   struct pipe_surface *dst = &sf->base;
    struct nv50_miptree *mt = nv50_miptree(dst->texture);
-   struct nv50_surface *sf = nv50_surface(dst);
    struct nouveau_bo *bo = mt->base.bo;
    unsigned z;
 
@@ -365,20 +365,44 @@ nv50_clear_render_target(struct pipe_context *pipe,
    nv50->dirty_3d |= NV50_NEW_3D_FRAMEBUFFER | NV50_NEW_3D_SCISSOR;
 }
 
+/* Callers may pass a plain pipe_surface template, such as a plane returned
+ * by pipe_video_buffer::get_surfaces, rather than a surface made by
+ * nv50_miptree_surface_new. Reading nv50_surface fields from a template
+ * reads past its end, so build the driver surface here.
+ */
 static void
-nv50_clear_depth_stencil(struct pipe_context *pipe,
+nv50_clear_render_target(struct pipe_context *pipe,
                          struct pipe_surface *dst,
-                         unsigned clear_flags,
-                         double depth,
-                         unsigned stencil,
+                         const union pipe_color_union *color,
                          unsigned dstx, unsigned dsty,
                          unsigned width, unsigned height,
                          bool render_condition_enabled)
+{
+   struct pipe_surface *ps = nv50_miptree_surface_new(pipe, dst->texture, dst);
+
+   if (!ps)
+      return;
+
+   nv50_clear_render_target_internal(pipe, nv50_surface(ps), color,
+                                     dstx, dsty, width, height,
+                                     render_condition_enabled);
+   nv50_surface_destroy(pipe, ps);
+}
+
+static void
+nv50_clear_depth_stencil_internal(struct pipe_context *pipe,
+                                  struct nv50_surface *sf,
+                                  unsigned clear_flags,
+                                  double depth,
+                                  unsigned stencil,
+                                  unsigned dstx, unsigned dsty,
+                                  unsigned width, unsigned height,
+                                  bool render_condition_enabled)
 {
    struct nv50_context *nv50 = nv50_context(pipe);
    struct nouveau_pushbuf *push = nv50->base.pushbuf;
+   struct pipe_surface *dst = &sf->base;
    struct nv50_miptree *mt = nv50_miptree(dst->texture);
-   struct nv50_surface *sf = nv50_surface(dst);
    struct nouveau_bo *bo = mt->base.bo;
    uint32_t mode = 0;
    unsigned z;
@@ -453,6 +477,27 @@ nv50_clear_depth_stencil(struct pipe_context *pipe,
    nv50->dirty_3d |= NV50_NEW_3D_FRAMEBUFFER | NV50_NEW_3D_SCISSOR;
 }
 
+static void
+nv50_clear_depth_stencil(struct pipe_context *pipe,
+                         struct pipe_surface *dst,
+                         unsigned clear_flags,
+                         double depth,
+                         unsigned stencil,
+                         unsigned dstx, unsigned dsty,
+                         unsigned width, unsigned height,
+                         bool render_condition_enabled)
+{
+   struct pipe_surface *ps = nv50_miptree_surface_new(pipe, dst->texture, dst);
+
+   if (!ps)
+      return;
+
+   nv50_clear_depth_stencil_internal(pipe, nv50_surface(ps), clear_flags,
+                                     depth, stencil, dstx, dsty, width, height,
+                                     render_condition_enabled);
+   nv50_surface_destroy(pipe, ps);
+}
+
 void
 nv50_clear(struct pipe_context *pipe, unsigned buffers, const struct pipe_scissor_state *scissor_state,
            const union pipe_color_union *color,
