From 83f20a5cc5dd94b592db4bb6fe4f788db177bcaf Mon Sep 17 00:00:00 2001
From: Francesco Stimola <francesco-stimola@users.noreply.github.com>
Date: Wed, 25 Nov 2026 15:59:58 +0100
Subject: [PATCH 15/16] nouveau: refuse interlaced vc1 pictures on vp3 to vp5

VP gets no field information for VC-1. It decodes the second field of a
field-interlaced frame wrongly, and the frames after it too, without any
error, and a stream mixing field pictures with interlaced frames hangs
it.

Refuse interlaced pictures, so that end_frame fails and the application
can fall back to software decoding. The check for frame_coding_mode 3
goes: the VA frontend passes field-interlaced pictures as 2.

Tested on a GeForce GT 240M (VP4) with FFmpeg's interlaced VC-1 streams
SA10143 and ilaced_twomv: every interlaced picture now fails in
vaEndPicture, with no GPU errors. Before, SA10143 decoded wrong from its
first second field on, and ilaced_twomv once hung the video engine.
Progressive VC-1, H.264 and MPEG-2 decode as before. The nvc0 part is
only built.
---
 .../drivers/nouveau/nouveau_vp3_video.h        | 16 ++++++++++++++++
 .../drivers/nouveau/nouveau_vp3_video_vp.c     |  2 --
 src/gallium/drivers/nouveau/nv50/nv98_video.c  | 18 +++++++++++++++++-
 src/gallium/drivers/nouveau/nvc0/nvc0_video.c  |  3 +++
 4 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/src/gallium/drivers/nouveau/nouveau_vp3_video.h b/src/gallium/drivers/nouveau/nouveau_vp3_video.h
index 8ea12ae..d7a1ce7 100644
--- a/src/gallium/drivers/nouveau/nouveau_vp3_video.h
+++ b/src/gallium/drivers/nouveau/nouveau_vp3_video.h
@@ -121,8 +121,24 @@ struct nouveau_vp3_decoder {
     * frame.
     */
    char *bsp_ptr;
+
+   /* The current picture was refused, see nouveau_vp3_vc1_interlaced() */
+   bool skip_picture;
 };
 
+/* VP gets no field information for VC-1: it decodes the second field of a
+ * field-interlaced frame wrongly, and interlaced frames can hang it.
+ * Interlaced pictures (frame_coding_mode 1 or 2, as the VA frontend passes
+ * them) are refused instead.
+ */
+static inline bool
+nouveau_vp3_vc1_interlaced(struct nouveau_vp3_decoder *dec,
+                           struct pipe_picture_desc *picture)
+{
+   return u_reduce_video_profile(dec->base.profile) == PIPE_VIDEO_FORMAT_VC1 &&
+          ((struct pipe_vc1_picture_desc *)picture)->frame_coding_mode != 0;
+}
+
 struct comm {
    uint32_t bsp_cur_index; // 000
    uint32_t byte_ofs; // 004
diff --git a/src/gallium/drivers/nouveau/nouveau_vp3_video_vp.c b/src/gallium/drivers/nouveau/nouveau_vp3_video_vp.c
index 3f120e4..523b02d 100644
--- a/src/gallium/drivers/nouveau/nouveau_vp3_video_vp.c
+++ b/src/gallium/drivers/nouveau/nouveau_vp3_video_vp.c
@@ -524,8 +524,6 @@ void nouveau_vp3_vp_caps(struct nouveau_vp3_decoder *dec, union pipe_desc desc,
    case PIPE_VIDEO_FORMAT_VC1: {
       *caps = nouveau_vp3_fill_picparm_vc1_vp(dec, desc.vc1, refs, is_ref, vp);
       nouveau_vp3_handle_references(dec, refs, dec->fence_seq, target);
-      if (desc.vc1->frame_coding_mode == 3)
-         debug_printf("Field-Interlaced possibly incorrectly handled\n");
       dec->refs[target->valid_ref].decoded_top = 1;
       dec->refs[target->valid_ref].decoded_bottom = 1;
       return;
diff --git a/src/gallium/drivers/nouveau/nv50/nv98_video.c b/src/gallium/drivers/nouveau/nv50/nv98_video.c
index 4918821..6b15513 100644
--- a/src/gallium/drivers/nouveau/nv50/nv98_video.c
+++ b/src/gallium/drivers/nouveau/nv50/nv98_video.c
@@ -37,13 +37,18 @@ nv98_decoder_decode_bitstream(struct pipe_video_codec *decoder,
 {
    struct nouveau_vp3_decoder *dec = (struct nouveau_vp3_decoder *)decoder;
    struct nouveau_vp3_video_buffer *target = (struct nouveau_vp3_video_buffer *)video_target;
-   uint32_t comm_seq = ++dec->fence_seq;
+   uint32_t comm_seq;
    union pipe_desc desc;
 
    unsigned vp_caps, is_ref;
    ASSERTED unsigned ret; /* used in debug checks */
    struct nouveau_vp3_video_buffer *refs[16] = {};
 
+   dec->skip_picture = nouveau_vp3_vc1_interlaced(dec, picture);
+   if (dec->skip_picture)
+      return;
+
+   comm_seq = ++dec->fence_seq;
    desc.base = picture;
 
    assert(target->base.buffer_format == PIPE_FORMAT_NV12);
@@ -59,6 +64,16 @@ nv98_decoder_decode_bitstream(struct pipe_video_codec *decoder,
    nv98_decoder_ppp(dec, desc, target, comm_seq);
 }
 
+static int
+nv98_decoder_end_frame(struct pipe_video_codec *decoder,
+                       struct pipe_video_buffer *target,
+                       struct pipe_picture_desc *picture)
+{
+   struct nouveau_vp3_decoder *dec = (struct nouveau_vp3_decoder *)decoder;
+
+   return dec->skip_picture ? -1 : 0;
+}
+
 static const struct nouveau_mclass
 nv98_decoder_msvld[] = {
    { G98_MSVLD, -1 },
@@ -179,6 +194,7 @@ nv98_create_decoder(struct pipe_context *context,
 
    dec->base.context = context;
    dec->base.decode_bitstream = nv98_decoder_decode_bitstream;
+   dec->base.end_frame = nv98_decoder_end_frame;
 
    for (i = 0; i < NOUVEAU_VP3_VIDEO_QDEPTH && !ret; ++i)
       ret = nouveau_bo_new(screen->device, NOUVEAU_BO_VRAM,
diff --git a/src/gallium/drivers/nouveau/nvc0/nvc0_video.c b/src/gallium/drivers/nouveau/nvc0/nvc0_video.c
index 4de4625..63f6e9d 100644
--- a/src/gallium/drivers/nouveau/nvc0/nvc0_video.c
+++ b/src/gallium/drivers/nouveau/nvc0/nvc0_video.c
@@ -76,6 +76,9 @@ nvc0_decoder_end_frame(struct pipe_video_codec *decoder,
    ASSERTED unsigned ret; /* used in debug checks */
    struct nouveau_vp3_video_buffer *refs[16] = {};
 
+   if (nouveau_vp3_vc1_interlaced(dec, picture))
+      return -1;
+
    desc.base = picture;
 
    ret = nvc0_decoder_bsp_end(dec, desc, target, comm_seq, &vp_caps, &is_ref, refs);
