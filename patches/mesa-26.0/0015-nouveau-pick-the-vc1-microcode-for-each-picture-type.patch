 static const struct nouveau_mclass
 nv98_decoder_msvld[] = {
    { G98_MSVLD, -1 },
@@ -179,6 +194,7 @@ nv98_create_decoder(struct pipe_context *context,
 
    dec->base.context = context;
    dec->base.decode_bitstream = nv98_decoder_decode_bitstream;
+   dec->base.end_frame = nv98_decoder_end_frame;
 
    for (i = 0; i < NOUVEAU_VP3_VIDEO_QDEPTH && !ret; ++i)
       ret = nouveau_bo_new(screen->device, NOUVEAU_BO_VRAM,
@@ -216,7 +232,10 @@ nv98_create_decoder(struct pipe_context *context,
    }
 
    ret = nouveau_bo_new(screen->device, NOUVEAU_BO_VRAM, 0,
-                           0x4000, NULL, &dec->fw_bo);
+                           u_reduce_video_profile(templ->profile) ==
+                           PIPE_VIDEO_FORMAT_VC1 ?
+                           3 * NOUVEAU_VP3_VC1_FW_STRIDE : 0x4000,
+                           NULL, &dec->fw_bo);
