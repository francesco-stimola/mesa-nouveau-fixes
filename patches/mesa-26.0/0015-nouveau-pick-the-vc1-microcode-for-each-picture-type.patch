 7 files changed, 143 insertions(+), 29 deletions(-)

diff --git a/src/gallium/drivers/nouveau/nouveau_vp3_video.c b/src/gallium/drivers/nouveau/nouveau_vp3_video.c
index f700c1a..0b1590f 100644
--- a/src/gallium/drivers/nouveau/nouveau_vp3_video.c
+++ b/src/gallium/drivers/nouveau/nouveau_vp3_video.c
@@ -301,31 +301,20 @@ static void vp4_getpath(enum pipe_video_profile profile, char *path)
    }
 }
 
-int
-nouveau_vp3_load_firmware(struct nouveau_vp3_decoder *dec,
-                          enum pipe_video_profile profile,
-                          unsigned chipset)
+static int
+vp3_read_firmware(const char *path, void *map, enum pipe_video_profile profile,
+                  unsigned *fw_sizes)
 {
    int fd;
-   char path[PATH_MAX];
    ssize_t r;
    uint32_t *end, endval;
-   struct nouveau_screen *screen = nouveau_screen(dec->base.context->screen);
-
-   if (chipset >= 0xa3 && chipset != 0xaa && chipset != 0xac)
-      vp4_getpath(profile, path);
-   else
-      vp3_getpath(profile, path);
-
-   if (BO_MAP(screen, dec->fw_bo, NOUVEAU_BO_WR, dec->client))
-      return 1;
 
    fd = open(path, O_RDONLY | O_CLOEXEC);
    if (fd < 0) {
       fprintf(stderr, "opening firmware file %s failed: %m\n", path);
       return 1;
    }
-   r = read(fd, dec->fw_bo->map, 0x4000);
+   r = read(fd, map, 0x4000);
    close(fd);
 
    if (r < 0) {
@@ -343,32 +332,79 @@ nouveau_vp3_load_firmware(struct nouveau_vp3_decoder *dec,
       return 1;
    }
 
-   end = dec->fw_bo->map + r - 4;
+   end = map + r - 4;
    endval = *end;
    while (endval == *end)
       end--;
 
-   r = (intptr_t)end - (intptr_t)dec->fw_bo->map + 4;
+   r = (intptr_t)end - (intptr_t)map + 4;
 
    switch (u_reduce_video_profile(profile)) {
       case PIPE_VIDEO_FORMAT_MPEG12: {
          assert((r & 0xff) == 0xe0);
-         dec->fw_sizes = (0x2e0<<16) | (r - 0x2e0);
+         *fw_sizes = (0x2e0<<16) | (r - 0x2e0);
          break;
       }
       case PIPE_VIDEO_FORMAT_VC1: {
          assert((r & 0xff) == 0xac);
-         dec->fw_sizes = (0x3ac<<16) | (r - 0x3ac);
+         *fw_sizes = (0x3ac<<16) | (r - 0x3ac);
          break;
       }
       case PIPE_VIDEO_FORMAT_MPEG4_AVC: {
          assert((r & 0xff) == 0x70);
-         dec->fw_sizes = (0x370<<16) | (r - 0x370);
+         *fw_sizes = (0x370<<16) | (r - 0x370);
          break;
       }
       default:
          return 1;
    }
+   return 0;
+}
+
+int
+nouveau_vp3_load_firmware(struct nouveau_vp3_decoder *dec,
+                          enum pipe_video_profile profile,
+                          unsigned chipset)
+{
+   char path[PATH_MAX];
+   bool vp4 = chipset >= 0xa3 && chipset != 0xaa && chipset != 0xac;
+   struct nouveau_screen *screen = nouveau_screen(dec->base.context->screen);
+
+   if (vp4)
+      vp4_getpath(profile, path);
+   else
+      vp3_getpath(profile, path);
+
+   if (BO_MAP(screen, dec->fw_bo, NOUVEAU_BO_WR, dec->client))
+      return 1;
+
+   if (vp3_read_firmware(path, dec->fw_bo->map, profile, &dec->fw_sizes))
+      return 1;
+
+   /* The microcode for interlaced pictures, see nouveau_vp3_vc1_fw_image().
+    * Only tested on GT21x and Fermi so far: on VP3, and unless both files
+    * are there, interlaced pictures are refused.
+    */
+   if (u_reduce_video_profile(profile) == PIPE_VIDEO_FORMAT_VC1) {
+      char paths[2][PATH_MAX];
+      struct stat s;
+      bool present = vp4 && chipset < 0xd0;
+
+      dec->vc1_fw_sizes[0] = dec->fw_sizes;
+      for (unsigned i = 0; i < 2; ++i) {
+         snprintf(paths[i], sizeof(paths[i]),
+                  vp4 ? "/lib/firmware/nouveau/vuc-vc1-%u" :
+                        "/lib/firmware/nouveau/vuc-vp3-vc1-%u", i + 1);
+         present = present && !stat(paths[i], &s);
+      }
+      for (unsigned i = 0; i < 2 && present; ++i)
+         present = !vp3_read_firmware(paths[i], (char *)dec->fw_bo->map +
+                                      (i + 1) * NOUVEAU_VP3_VC1_FW_STRIDE,
+                                      profile, &dec->vc1_fw_sizes[i + 1]);
+      if (!present)
+         dec->vc1_fw_sizes[1] = dec->vc1_fw_sizes[2] = 0;
+   }
+
    munmap(dec->fw_bo->map, dec->fw_bo->size);
    dec->fw_bo->map = NULL;
    return 0;
diff --git a/src/gallium/drivers/nouveau/nouveau_vp3_video.h b/src/gallium/drivers/nouveau/nouveau_vp3_video.h
index 47c555a..2b8de64 100644
--- a/src/gallium/drivers/nouveau/nouveau_vp3_video.h
+++ b/src/gallium/drivers/nouveau/nouveau_vp3_video.h
@@ -114,14 +114,55 @@ struct nouveau_vp3_decoder {
    struct nouveau_vp3_video_buffer *h264_refs[16];
    unsigned fence_seq, fw_sizes, last_frame_num, tmp_stride, ref_stride;
 
+   /* VC-1 has one VP microcode per picture type, vuc-vc1-0 to 2, loaded
+    * NOUVEAU_VP3_VC1_FW_STRIDE apart in fw_bo. 1 and 2 are 0 unless both
+    * were loaded.
+    */
+   unsigned vc1_fw_sizes[3];
+
    unsigned bsp_idx, vp_idx, ppp_idx;
 
    /* End of the bsp bo where new data should be appended between one begin/end
     * frame.
     */
    char *bsp_ptr;
+
+   /* The current picture was refused, see nouveau_vp3_vc1_refused() */
+   bool skip_picture;
 };
 
+#define NOUVEAU_VP3_VC1_FW_STRIDE 0x4000
+
+/* The VC-1 microcode for a picture, as NVIDIA's driver picks it:
+ * vuc-vc1-0 for progressive pictures, vuc-vc1-1 for fields, vuc-vc1-2 for
+ * interlaced frames. frame_coding_mode is 0 progressive, 1 interlaced
+ * frame, 2 field, as the VA frontend passes it.
+ */
+static inline unsigned
+nouveau_vp3_vc1_fw_image(const struct pipe_vc1_picture_desc *d)
+{
+   static const unsigned image[3] = { 0, 2, 1 };
+
+   return d->frame_coding_mode < 3 ? image[d->frame_coding_mode] : 0;
+}
+
+/* Interlaced VC-1 pictures need their own microcode. Without it (VP5 has no
+ * fw_bo, it isn't loaded where untested, or a file is missing) VP decodes
+ * them wrongly and can hang, so they are refused instead and the
+ * application can decode them in software.
+ */
+static inline bool
+nouveau_vp3_vc1_refused(struct nouveau_vp3_decoder *dec,
+                        struct pipe_picture_desc *picture)
+{
+   struct pipe_vc1_picture_desc *d = (struct pipe_vc1_picture_desc *)picture;
+
+   return u_reduce_video_profile(dec->base.profile) == PIPE_VIDEO_FORMAT_VC1 &&
+          d->frame_coding_mode != 0 &&
+          (d->frame_coding_mode > 2 ||
+           !dec->vc1_fw_sizes[nouveau_vp3_vc1_fw_image(d)]);
+}
+
 struct comm {
    uint32_t bsp_cur_index; // 000
    uint32_t byte_ofs; // 004
