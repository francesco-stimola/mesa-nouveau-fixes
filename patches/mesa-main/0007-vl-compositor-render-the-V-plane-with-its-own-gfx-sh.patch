 src/gallium/auxiliary/vl/vl_compositor.h     |  3 ++
 src/gallium/auxiliary/vl/vl_compositor_gfx.c | 13 +++++---
 src/gallium/auxiliary/vl/vl_compositor_gfx.h | 10 +++---
 4 files changed, 38 insertions(+), 22 deletions(-)

